# Copy this file to .env and fill in your values
# Never commit .env — it contains real API keys

# Required — get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional — only needed for CLI job search agent
# Get yours at https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key-here

# Optional — override backend URL for the frontend (default: http://localhost:8000)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional — restrict CORS origins on the backend (default: http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000
